<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppToolbarStyle" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/on_surface</item>
        <item name="navigationIconTint">@color/on_surface</item>
        <item name="actionMenuTextColor">@color/menu_text_color</item>
    </style>

    <style name="FilterChipStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_chip_dark</item>
    </style>

    <style name="FilterLabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
