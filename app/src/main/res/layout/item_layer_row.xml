<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_layer_item"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/layerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnLayerVisible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_circle"
            android:padding="8dp"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnMoveUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_circle"
            android:padding="8dp"
            android:src="@drawable/ic_move_up"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnMoveDown"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_circle"
            android:padding="8dp"
            android:src="@drawable/ic_move_down"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/layerMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Прозрачность: 100%"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/layerOpacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="100" />

</LinearLayout>