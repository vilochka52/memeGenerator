<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_layers_sheet">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Фильтры"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/presetOriginal"
                    style="@style/FilterChipStyle"
                    android:text="Оригинал" />

                <TextView
                    android:id="@+id/presetBw"
                    style="@style/FilterChipStyle"
                    android:text="Ч/Б" />

                <TextView
                    android:id="@+id/presetWarm"
                    style="@style/FilterChipStyle"
                    android:text="Тёплый" />

                <TextView
                    android:id="@+id/presetCold"
                    style="@style/FilterChipStyle"
                    android:text="Холодный" />

                <TextView
                    android:id="@+id/presetVivid"
                    style="@style/FilterChipStyle"
                    android:text="Яркий" />

                <TextView
                    android:id="@+id/presetVintage"
                    style="@style/FilterChipStyle"
                    android:text="Винтаж" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            style="@style/FilterLabelStyle"
            android:text="Яркость" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="-100"
            android:valueTo="100"
            android:stepSize="1"
            android:value="0" />

        <TextView
            style="@style/FilterLabelStyle"
            android:text="Контраст" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderContrast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="2"
            android:stepSize="0.01"
            android:value="1" />

        <TextView
            style="@style/FilterLabelStyle"
            android:text="Насыщенность" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSaturation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="2"
            android:stepSize="0.01"
            android:value="1" />

        <TextView
            style="@style/FilterLabelStyle"
            android:text="Теплота" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderWarmth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="-100"
            android:valueTo="100"
            android:stepSize="1"
            android:value="0" />

        <TextView
            style="@style/FilterLabelStyle"
            android:text="Оттенок" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderHue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="-180"
            android:valueTo="180"
            android:stepSize="1"
            android:value="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnResetFilters"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Сброс"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_button_secondary" />

            <TextView
                android:id="@+id/btnCancelFilters"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="Отмена"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_button_secondary" />

            <TextView
                android:id="@+id/btnApplyFilters"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="Применить"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>